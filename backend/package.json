{
  "name": "kolejowe-ai-backend",
  "version": "0.1.0",
  "description": "Payload CMS backend for kolejowe.ai -- source of truth for line/station data, with agent-written drafts and human-reviewed publishing.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/seed.ts",
    "agent:ensure": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/runEnsureUsers.ts",
    "agent:setup": "cross-env NODE_OPTIONS=--no-deprecation tsx src/jobs/setupAgentUser.ts",
    "agent:sync": "cross-env NODE_OPTIONS=--no-deprecation tsx src/jobs/run.ts",
    "agent:sync:all": "cross-env NODE_OPTIONS=--no-deprecation tsx src/jobs/run.ts -- --all",
    "agent:verify-overview": "cross-env NODE_OPTIONS=--no-deprecation tsx src/jobs/runVerifyOverview.ts",
    "agent:verify-overview:all": "cross-env NODE_OPTIONS=--no-deprecation tsx src/jobs/runVerifyOverview.ts -- --all",
    "agent:verify-history": "cross-env NODE_OPTIONS=--no-deprecation tsx src/jobs/runVerifyHistory.ts",
    "agent:verify-history:all": "cross-env NODE_OPTIONS=--no-deprecation tsx src/jobs/runVerifyHistory.ts -- --all",
    "agent:setup-timetable-sync": "cross-env NODE_OPTIONS=--no-deprecation tsx src/jobs/setupTimetableSyncUser.ts",
    "agent:check-timetable-version": "cross-env NODE_OPTIONS=--no-deprecation tsx src/jobs/checkTimetableVersion.ts",
    "agent:sync-timetables": "cross-env NODE_OPTIONS=--no-deprecation tsx src/jobs/runSyncTimetables.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation tsx src/db/runMigrations.ts",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/db-sqlite": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@sentry/nextjs": "11.9.0",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.4.3",
    "payload": "3.92.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^24.22.1"
  }
}
