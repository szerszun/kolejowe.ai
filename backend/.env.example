DATABASE_URL=file:./kolejowe.db
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Printed once by `npm run agent:setup` -- paste it here.
AGENT_API_KEY=
# Free-tier key from https://pdp-api.plk-sa.pl -- powers live arrivals/departures.
PLK_API_KEY=
# Base URL the agent job's REST calls go to. Defaults to http://localhost:3000.
# PAYLOAD_URL=http://localhost:3000

# --- Production only (e.g. Render) -- leave unset for local dev ---
# Extra CORS origins (comma-separated full URLs), e.g. a custom domain.
# CORS_ORIGINS=
